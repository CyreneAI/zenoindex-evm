# Copy to .env and fill in. Never commit .env.
# Do not paste PRIVATE_KEY into chat.

PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Robinhood Chain Testnet (chainId 46630) — recommended first
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Robinhood Chain Mainnet (chainId 4663) — when ready:
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Required for Deploy.s.sol — paste real addresses
STABLECOIN=0xYourUsdcOrUsdgAddress

# Optional — defaults to the deployer address derived from PRIVATE_KEY
# TREASURY=0xYourTreasuryAddress

# Not read by Deploy.s.sol — wire the swap router in a follow-up call to
# ZenoIndexVault.setSwapRouter(...) after deploy, and authorize the factory on the
# adapter (UniswapV4Adapter.setAuthorizedCaller). createVault reverts until the router
# is set and every basket asset is priced.

# Optional — register asset mints during deploy (ASSET_0 .. ASSET_4)
# ASSET_0=0xTokenA
# ASSET_1=0xTokenB
# Optional — USDC (6-dec) per whole token, set via setPriceWhole before createAsset
# ASSET_0_PRICE=1000000
# ASSET_1_PRICE=2500000
