# Copy to .env and fill in. Never commit .env.
# Do not paste PRIVATE_KEY into chat.

PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Robinhood Chain Testnet (chainId 46630) — recommended first
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Robinhood Chain Mainnet (chainId 4663) — when ready:
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Required for Deploy.s.sol — paste real addresses
STABLECOIN=0xYourUsdcOrUsdgAddress
SWAP_ROUTER=0xYourSwapRouterOrUniswapV4AdapterAddress

# Optional — defaults to the deployer address derived from PRIVATE_KEY
# TREASURY=0xYourTreasuryAddress

# Optional — register asset mints during deploy (ASSET_0 .. ASSET_4)
# ASSET_0=0xTokenA
# ASSET_1=0xTokenB
